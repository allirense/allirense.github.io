---
const { title } = Astro.props;
import '../styles/global.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&display=swap" rel="stylesheet">
    <title>{title}</title>
  </head>
  <body class="bg-black font-lora min-h-screen flex flex-col">
    <main class="h-full grow flex flex-col">
      <slot/>
    </main>
    <footer class="footer font-mono bg-deepgreen p-2 px-4 text-xs md:text-sm text-brightgreen">
      <div class="inline-flex items-center"><span class="text-lg">&copy;</span> Copyright 2025 by Alli Rense.</div>
    </footer>
  </body>
  </body>
</html>